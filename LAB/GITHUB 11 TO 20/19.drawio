        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Start State\n    Start(( )):::startNode --&gt; N1([enter the train&lt;br&gt;number]):::umlNode\n    \n    %% Main Flow\n    N1 --&gt; N2([enter the&lt;br&gt;number of seats]):::umlNode\n    N2 --&gt; D1{ }:::umlNode\n    \n    %% Decision Paths\n    D1 -- check availability --&gt; N3([acceptanc&lt;br&gt;e of ticket]):::umlNode\n    D1 -- not available --&gt; N4([check for&lt;br&gt;waiting list]):::umlNode\n    \n    %% Waiting List Flow\n    N4 --&gt; N5([cancellatio&lt;br&gt;n]):::umlNode\n    N5 --&gt; N6([accept&lt;br&gt;seat]):::umlNode\n    \n    %% Synchronization Bar\n    N3 --&gt; SyncBar[ ]:::syncBar\n    N6 --&gt; SyncBar\n    \n    %% End State\n    SyncBar --&gt; End((( ))):::endNode\n\n    %% Styling Classes (Matching the Draw.io aesthetic)\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#000,stroke:#800000,stroke-width:4px;\n    classDef umlNode fill:#ffffe0,stroke:#800000,stroke-width:1px,color:#000;\n    classDef syncBar fill:#800000,stroke:#800000,height:8px;\n    \n    %% Global Link Styling\n    linkStyle default stroke:#800000,stroke-width:1px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wkUY_G75NKAGbGlxCZKs-1">
