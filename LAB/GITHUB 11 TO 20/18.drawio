        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Start State\n    Start(( )):::startNode --&gt; N1([browse&lt;br&gt;course]):::umlNode\n    \n    %% Main Flow\n    N1 --&gt; N2([select&lt;br&gt;course]):::umlNode\n    N2 --&gt; D1{check&lt;br&gt;availablity}:::umlNode\n    \n    %% Decision Loop\n    D1 -- not available --&gt; N1\n    \n    %% Continuation Flow\n    D1 --&gt; N3([register&lt;br&gt;course]):::umlNode\n    N3 --&gt; N4([submit&lt;br&gt;details]):::umlNode\n    N4 --&gt; N5([pay fees]):::umlNode\n    N5 --&gt; N6([enroll]):::umlNode\n    \n    %% End State\n    N6 --&gt; End((( ))):::endNode\n\n    %% Styling Classes (Matching the Draw.io aesthetic)\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#000,stroke:#800000,stroke-width:4px;\n    classDef umlNode fill:#ffffe0,stroke:#800000,stroke-width:1px,color:#000;\n    \n    %% Global Link Styling\n    linkStyle default stroke:#800000,stroke-width:1px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R_S_5jfPdz9AwauV5HGj-1">
