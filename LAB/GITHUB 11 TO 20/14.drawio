        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Start State\n    Start(( )):::startNode --&gt; N1([Enter applicant&lt;br&gt;details]):::umlNode\n    \n    %% Main Flow\n    N1 --&gt; N2([Submission of&lt;br&gt;proofs]):::umlNode\n    N2 --&gt; N3([Verification of&lt;br&gt;details]):::umlNode\n    N3 --&gt; N4{Check details}:::umlNode\n    \n    %% Decision Paths from Check details\n    N4 -- No --&gt; N2\n    N4 -- Yes --&gt; SyncBar[ ]:::syncBar\n    \n    %% Secondary Flow (Enquiry)\n    N5{Enquiry satisfied}:::umlNode -- Yes --&gt; SyncBar\n    N5 -- No --&gt; N6([Correct details&lt;br&gt;reply]):::umlNode\n    \n    %% Post-Sync Flow\n    SyncBar --&gt; N7([Issue of&lt;br&gt;passport]):::umlNode\n    \n    %% End State\n    N7 --&gt; End((( ))):::endNode\n\n    %% Styling Classes (Matching the Draw.io aesthetic)\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#000,stroke:#800000,stroke-width:4px;\n    classDef umlNode fill:#ffffe0,stroke:#800000,stroke-width:1px,color:#000;\n    classDef syncBar fill:#800000,stroke:#800000,height:8px;\n    \n    %% Global Link Styling\n    linkStyle default stroke:#800000,stroke-width:1px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9X_vytxlDm4VpoRgNsAo-1">
